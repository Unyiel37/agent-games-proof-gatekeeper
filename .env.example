# Copy this file to .env and fill in the values. Never commit .env.
# The HMAC secret comes from the Agent Games dashboard (Rotate Secret).
# The Kurier key comes from https://kurier.xyz (mainnet API key).

# HTTP port the agent listens on
PORT=3000

# Platform-issued HMAC secret (required) — from the dashboard "Rotate Secret"
AGENT_GAMES_HMAC_SECRET=

# Kurier API key for zkVerify submission (optional — without it the agent
# returns the locally generated proof without an on-chain submission)
KURIER_API_KEY=

# Optional override for the Kurier job-status endpoint
KURIER_STATUS_URL=

# Groth16 circuit artifacts (downloaded from the official Agent Games
# build guide, artifacts section — not committed to this repo)
CIRCUIT_WASM_PATH=./circuits/gatekeeper.wasm
CIRCUIT_ZKEY_PATH=./circuits/gatekeeper_final.zkey

# Verification-key hash of the Proof Gatekeeper circuit, registered on
# zkVerify mainnet
REGISTERED_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
